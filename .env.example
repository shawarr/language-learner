# Copy to .env and fill in. Never commit .env. Keys stay server-side; the frontend never sees them.

# --- auth -------------------------------------------------------------------
# The single password you log in with. Long and random; it is the only thing between
# the internet and your API quota.
APP_PASSWORD=change-me
# Optional. If unset, a secret is generated once and stored in the DB (sessions then
# survive restarts but not a DB wipe). Set it to keep sessions across DB restores.
SESSION_SECRET=
# 0 only for local http:// development. Over https keep it 1.
COOKIE_SECURE=1
SESSION_DAYS=365

# --- api keys ---------------------------------------------------------------
# https://aistudio.google.com/apikey  (free tier, no card)
GEMINI_API_KEY=
# https://console.groq.com/keys      (free tier, no card)
GROQ_API_KEY=

# --- models (provider:model) ------------------------------------------------
# Free tier as of Oct 2026. Swap any of these without touching code.
LLM_PRIMARY=gemini:gemini-3.8-flash
LLM_FALLBACK=groq:openai/gpt-oss-120b
LLM_FAST=gemini:gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GROQ_REASONING_EFFORT=low
LLM_TIMEOUT=60

# --- speech to text ---------------------------------------------------------
# groq = whisper-large-v3 (language=de, no prompt). gemini = inline audio, verbatim instruction.
# The other one is used automatically as the fallback. See docs/STT-FINDINGS.md.
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3
GEMINI_STT_MODEL=gemini-3.8-flash
# Leave EMPTY. A prompt written in clean German makes Whisper "fix" your grammar,
# which hides exactly the mistakes this app exists to catch.
WHISPER_PROMPT=

# --- text to speech ---------------------------------------------------------
TTS_PROVIDER=edge
# de-DE-SeraphinaMultilingualNeural (f), de-DE-FlorianMultilingualNeural (m),
# de-DE-KatjaNeural (f), de-DE-ConradNeural (m), de-AT-*, de-CH-*
TTS_VOICE=de-DE-SeraphinaMultilingualNeural
TTS_RATE_NORMAL=-5%
TTS_RATE_SLOW=-30%
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# --- tutor behaviour --------------------------------------------------------
# Run the analyzer every N user turns inside a long session (plus once at session end).
ANALYZE_EVERY_TURNS=8
# How many past messages go into the prompt before the rolling summary takes over.
HISTORY_WINDOW=14

# --- storage ----------------------------------------------------------------
DATA_DIR=/data
