# Copy to .env and fill in. Never commit .env. Keys stay server-side; the frontend never sees them.

# --- accounts ---------------------------------------------------------------
# The learners, by username. Names, genders and the tutor's paragraph about each live in
# app/curriculum/personas.json. One password per account, hashed on boot (PBKDF2) and never stored
# in clear; change a line here and the hash rotates on the next restart.
USERS=ahmad,maryan
USER_AHMAD_PASSWORD=change-me
USER_MARYAN_PASSWORD=change-me-too
# Legacy fallback: opens an account that has no password hash yet. Leave empty once the lines above are set.
APP_PASSWORD=
# Optional. If unset, a secret is generated once and stored in the DB (sessions then
# survive restarts but not a DB wipe). Set it to keep sessions across DB restores.
SESSION_SECRET=
# 0 only for local http:// development. Over https keep it 1.
COOKIE_SECURE=1
SESSION_DAYS=365

# --- api keys ---------------------------------------------------------------
# https://aistudio.google.com/apikey  (free tier, no card)
GEMINI_API_KEY=
# https://console.groq.com/keys      (free tier, no card)
GROQ_API_KEY=

# Optional extra providers. Every OpenAI-compatible endpoint works with the same code, so
# moving to whatever is good and free is a key here plus a model string in LLM_* below —
# e.g. LLM_PRIMARY=openrouter:some-model:free. Leave blank to skip.
OPENROUTER_API_KEY=      # https://openrouter.ai/keys — many models, some ':free'
CEREBRAS_API_KEY=        # very fast, but the no-card free tier ended Aug 2026
MISTRAL_API_KEY=         # https://console.mistral.ai — free tier available
TOGETHER_API_KEY=
# Anything else, including a local vLLM/Ollama. Then use "custom:<model>" in LLM_*.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- models (provider:model) ------------------------------------------------
# Free tier as of Oct 2026, with measured latency/reliability behind the split —
# see docs/FOUNDATION.md. Swap any of these without touching code.
# Conversation: Groq answers in ~1s; Gemini takes 2-3s and 503s under load.
LLM_PRIMARY=groq:openai/gpt-oss-120b
LLM_FALLBACK=gemini:gemini-3.5-flash-lite
# Judgement calls that run rarely (analyzer, placement, checkpoint grading). Gemini spots
# recurring patterns Groq misses. Do NOT use gemini-3.8-flash: 20 requests per DAY on free.
LLM_QUALITY=gemini:gemini-3.5-flash
# High-frequency cheap calls (word translation, drill grading) on their own daily quota.
LLM_FAST=groq:openai/gpt-oss-20b
GEMINI_THINKING_LEVEL=low
GROQ_REASONING_EFFORT=low
LLM_TIMEOUT=60

# --- speech to text ---------------------------------------------------------
# groq = whisper-large-v3 (language=de, no prompt). gemini = inline audio, verbatim instruction.
# The other one is used automatically as the fallback. See docs/STT-FINDINGS.md.
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3
GEMINI_STT_MODEL=gemini-3.5-flash-lite
# Leave EMPTY. A prompt written in clean German makes Whisper "fix" your grammar,
# which hides exactly the mistakes this app exists to catch.
WHISPER_PROMPT=

# --- text to speech ---------------------------------------------------------
TTS_PROVIDER=edge
# German-only voices: de-DE-KatjaNeural (f), de-DE-ConradNeural (m), de-DE-AmalaNeural (f),
# de-DE-KillianNeural (m), de-AT-*, de-CH-*. Never a *Multilingual* voice: it reads short or
# English-looking German ("das Team", "der Code") in English. Those are mapped away in config.py.
# TTS_VOICE_2 is the second speaker in lesson dialogues.
TTS_VOICE=de-DE-KatjaNeural
TTS_VOICE_2=de-DE-ConradNeural
TTS_RATE_NORMAL=-5%
TTS_RATE_SLOW=-30%
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_VOICE_2=Puck

# --- tutor behaviour --------------------------------------------------------
# Run the analyzer every N user turns inside a long session (plus once at session end).
ANALYZE_EVERY_TURNS=8
# How many past messages go into the prompt before the rolling summary takes over.
HISTORY_WINDOW=14

# --- storage ----------------------------------------------------------------
DATA_DIR=/data
